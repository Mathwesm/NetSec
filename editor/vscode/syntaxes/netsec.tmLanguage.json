{
  "scopeName": "source.netsec",
  "patterns": [
    {
      "name": "comment.line.double-slash.netsec",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.netsec",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.netsec",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "storage.type.netsec",
      "match": "\\b(int|bool|string|ip|network|port|protocol)\\b"
    },
    {
      "name": "keyword.control.netsec",
      "match": "\\b(class|import|server|http|response|record|fn|group|host|address|play|targets|check|service|dns|expect|firewall|allow|deny|report|if|else|repeat|and|or|not|in)\\b"
    },
    {
      "name": "constant.language.netsec",
      "match": "\\b(true|false|tcp|udp)\\b"
    },
    {
      "name": "constant.numeric.netsec",
      "match": "\\b[0-9]+\\b"
    }
  ]
}
